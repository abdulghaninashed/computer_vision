# Telegram police notification settings
# Replace the example values, then copy this file to .env in the project root.

# Notifications for violations in the going direction
TELEGRAM_GOING_BOT_TOKEN=your_going_bot_token
TELEGRAM_GOING_CHAT_ID=your_going_chat_id

# Notifications for violations in the returning direction
TELEGRAM_RETURNING_BOT_TOKEN=your_returning_bot_token
TELEGRAM_RETURNING_CHAT_ID=your_returning_chat_id
